{
    "name": "mchristie/semaphore",
    "description": "Compress multiple typed values into the fewest possible characters",
    "type": "library",
    "keywords": ["compression", "encoding", "bit-packing", "jwt", "serialization", "url"],
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "MChristie\\Semaphore\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MChristie\\Semaphore\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "authors": [
        {
            "name": "Malcolm Christie",
            "email": "malcolm@christiesmedia.co.uk"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
