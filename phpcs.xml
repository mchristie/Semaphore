<?xml version="1.0"?>
<ruleset name="Semaphore">
    <description>Coding standard for the Semaphore library.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="16"/>
    <arg value="np"/>

    <!-- Target PHP 8.3+ -->
    <config name="php_version" value="80300"/>

    <rule ref="PSR12"/>

    <!-- Test methods use readable snake_case names (test_it_does_a_thing). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.NamingConventions.ValidFunctionName.ScopeNotCamelCaps">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
